HOST=127.0.0.1
PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:3000
DATA_DIR=./data
# Optional: active sessions already persist locally on disk without Redis.
# REDIS_URL=redis://127.0.0.1:6379
# Bundled FFmpeg and FFprobe are used by default. Override for your system builds:
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
# FFPROBE_PATH=C:/ffmpeg/bin/ffprobe.exe
MAX_ACTIVE_TORRENTS=8
MAX_MEDIA_PROCESSES=4
MAX_PEER_CONNECTIONS=100
# Upload bytes per second across all torrents. -1 means unlimited.
# Keep headroom for other traffic on asymmetric home connections.
UPLOAD_LIMIT_BYTES=3000000
METADATA_TIMEOUT_MS=120000
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=your-publishable-key
