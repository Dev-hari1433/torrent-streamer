{
  "name": "@lumora/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "node test/run-tests.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.2.0",
    "@fastify/multipart": "9.3.0",
    "@supabase/supabase-js": "2.116.0",
    "fastify": "5.12.5",
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0",
    "fs-chunk-store": "5.0.1",
    "fs-native-extensions": "1.5.1",
    "ioredis": "5.8.1",
    "parse-torrent": "11.0.24",
    "webtorrent": "3.0.21",
    "ws": "8.18.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/webtorrent": "3.0.0",
    "@types/ws": "8.18.1",
    "tsx": "4.20.6"
  }
}
